<?xml version='1.0' encoding='windows-1252'?>

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='ExamHelper'
        UpgradeCode='A1B2C3D4-E5F6-7890-ABCD-EF1234567890'
        Manufacturer='ophiocus'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Pluggable learning console with cartridge-based study modules, TTS narration, and exam practice'
            Manufacturer='ophiocus'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            AllowSameVersionUpgrades='yes'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='ExamHelper Installation'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='examhelper'>

                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile' DiskId='1' Source='wix\License.rtf' KeyPath='yes'/>
                    </Component>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='B2C3D4E5-F6A7-8901-BCDE-F23456789012' KeyPath='yes'>
                            <Environment Id='PATH' Name='PATH' Value='[Bin]' Permanent='no' Part='last' Action='set' System='yes'/>
                        </Component>
                        <Component Id='binary0' Guid='*'>
                            <File Id='exe0' Name='examhelper.exe' DiskId='1' Source='$(var.CargoTargetBinDir)\examhelper.exe' KeyPath='yes'/>
                        </Component>
                    </Directory>

                    <!-- ── Cartridges ──────────────────────────────────────── -->
                    <Directory Id='Cartridges' Name='cartridges'>

                        <!-- Colombian Nationality -->
                        <Directory Id='CartColombian' Name='colombian-nationality'>
                            <Component Id='col_manifest' Guid='*'>
                                <File Id='col_manifest_f' Source='cartridges\colombian-nationality\manifest.toml' KeyPath='yes'/>
                            </Component>

                            <Directory Id='ColContent' Name='content'>
                                <Directory Id='ColConstitucion' Name='01-constitucion'>
                                    <Component Id='cc01' Guid='*'><File Id='fcc01' Source='cartridges\colombian-nationality\content\01-constitucion\01-estructura-del-estado.md' KeyPath='yes'/></Component>
                                    <Component Id='cc02' Guid='*'><File Id='fcc02' Source='cartridges\colombian-nationality\content\01-constitucion\02-ramas-del-poder.md' KeyPath='yes'/></Component>
                                    <Component Id='cc03' Guid='*'><File Id='fcc03' Source='cartridges\colombian-nationality\content\01-constitucion\03-derechos-fundamentales.md' KeyPath='yes'/></Component>
                                    <Component Id='cc04' Guid='*'><File Id='fcc04' Source='cartridges\colombian-nationality\content\01-constitucion\04-participacion-democratica.md' KeyPath='yes'/></Component>
                                    <Component Id='cc05' Guid='*'><File Id='fcc05' Source='cartridges\colombian-nationality\content\01-constitucion\05-nacionalidad.md' KeyPath='yes'/></Component>
                                    <Component Id='cc06' Guid='*'><File Id='fcc06' Source='cartridges\colombian-nationality\content\01-constitucion\06-organismos-de-control.md' KeyPath='yes'/></Component>
                                    <Component Id='cc07' Guid='*'><File Id='fcc07' Source='cartridges\colombian-nationality\content\01-constitucion\07-organizacion-territorial.md' KeyPath='yes'/></Component>
                                </Directory>
                                <Directory Id='ColHistoria' Name='02-historia'>
                                    <Component Id='ch01' Guid='*'><File Id='fch01' Source='cartridges\colombian-nationality\content\02-historia\01-epoca-precolombina.md' KeyPath='yes'/></Component>
                                    <Component Id='ch01b' Guid='*'><File Id='fch01b' Source='cartridges\colombian-nationality\content\02-historia\01b-colonia.md' KeyPath='yes'/></Component>
                                    <Component Id='ch02' Guid='*'><File Id='fch02' Source='cartridges\colombian-nationality\content\02-historia\02-independencia.md' KeyPath='yes'/></Component>
                                    <Component Id='ch03' Guid='*'><File Id='fch03' Source='cartridges\colombian-nationality\content\02-historia\03-republica.md' KeyPath='yes'/></Component>
                                    <Component Id='ch04' Guid='*'><File Id='fch04' Source='cartridges\colombian-nationality\content\02-historia\04-personajes-importantes.md' KeyPath='yes'/></Component>
                                    <Component Id='ch05' Guid='*'><File Id='fch05' Source='cartridges\colombian-nationality\content\02-historia\05-guerra-mil-dias-y-panama.md' KeyPath='yes'/></Component>
                                    <Component Id='ch06' Guid='*'><File Id='fch06' Source='cartridges\colombian-nationality\content\02-historia\06-conflicto-armado-y-paz.md' KeyPath='yes'/></Component>
                                    <Component Id='ch07' Guid='*'><File Id='fch07' Source='cartridges\colombian-nationality\content\02-historia\07-constitucion-de-1991.md' KeyPath='yes'/></Component>
                                </Directory>
                                <Directory Id='ColGeografia' Name='03-geografia'>
                                    <Component Id='cg01' Guid='*'><File Id='fcg01' Source='cartridges\colombian-nationality\content\03-geografia\01-datos-generales.md' KeyPath='yes'/></Component>
                                    <Component Id='cg02' Guid='*'><File Id='fcg02' Source='cartridges\colombian-nationality\content\03-geografia\02-regiones-naturales.md' KeyPath='yes'/></Component>
                                    <Component Id='cg03' Guid='*'><File Id='fcg03' Source='cartridges\colombian-nationality\content\03-geografia\03-departamentos-y-capitales.md' KeyPath='yes'/></Component>
                                    <Component Id='cg04' Guid='*'><File Id='fcg04' Source='cartridges\colombian-nationality\content\03-geografia\04-rios-y-relieve.md' KeyPath='yes'/></Component>
                                    <Component Id='cg05' Guid='*'><File Id='fcg05' Source='cartridges\colombian-nationality\content\03-geografia\05-biodiversidad.md' KeyPath='yes'/></Component>
                                </Directory>
                                <Directory Id='ColCultura' Name='04-cultura'>
                                    <Component Id='ccu01' Guid='*'><File Id='fccu01' Source='cartridges\colombian-nationality\content\04-cultura\01-simbolos-nacionales.md' KeyPath='yes'/></Component>
                                    <Component Id='ccu02' Guid='*'><File Id='fccu02' Source='cartridges\colombian-nationality\content\04-cultura\02-himno-nacional.md' KeyPath='yes'/></Component>
                                    <Component Id='ccu03' Guid='*'><File Id='fccu03' Source='cartridges\colombian-nationality\content\04-cultura\03-fiestas-y-patrimonio.md' KeyPath='yes'/></Component>
                                    <Component Id='ccu04' Guid='*'><File Id='fccu04' Source='cartridges\colombian-nationality\content\04-cultura\04-patrimonio-unesco.md' KeyPath='yes'/></Component>
                                    <Component Id='ccu05' Guid='*'><File Id='fccu05' Source='cartridges\colombian-nationality\content\04-cultura\05-diversidad-etnica-y-linguistica.md' KeyPath='yes'/></Component>
                                    <Component Id='ccu06' Guid='*'><File Id='fccu06' Source='cartridges\colombian-nationality\content\04-cultura\06-gastronomia-y-deportes.md' KeyPath='yes'/></Component>
                                </Directory>
                            </Directory>

                            <Directory Id='ColQuestions' Name='questions'>
                                <Component Id='cq01' Guid='*'><File Id='fcq01' Source='cartridges\colombian-nationality\questions\constitucion.toml' KeyPath='yes'/></Component>
                                <Component Id='cq02' Guid='*'><File Id='fcq02' Source='cartridges\colombian-nationality\questions\historia.toml' KeyPath='yes'/></Component>
                                <Component Id='cq03' Guid='*'><File Id='fcq03' Source='cartridges\colombian-nationality\questions\geografia.toml' KeyPath='yes'/></Component>
                                <Component Id='cq04' Guid='*'><File Id='fcq04' Source='cartridges\colombian-nationality\questions\cultura.toml' KeyPath='yes'/></Component>
                            </Directory>
                        </Directory>

                        <!-- Japanese 100 -->
                        <Directory Id='CartJapanese' Name='japanese-100'>
                            <Component Id='jp_manifest' Guid='*'>
                                <File Id='jp_manifest_f' Source='cartridges\japanese-100\manifest.toml' KeyPath='yes'/>
                            </Component>

                            <Directory Id='JpFonts' Name='fonts'>
                                <Component Id='jp_font' Guid='*'>
                                    <File Id='fjp_font' Source='cartridges\japanese-100\fonts\NotoSansJP-Regular.otf' KeyPath='yes'/>
                                </Component>
                            </Directory>

                            <Directory Id='JpContent' Name='content'>
                                <Directory Id='JpWriting' Name='01-writing-systems'>
                                    <Component Id='jw01' Guid='*'><File Id='fjw01' Source='cartridges\japanese-100\content\01-writing-systems\01-introduction.md' KeyPath='yes'/></Component>
                                    <Component Id='jw02' Guid='*'><File Id='fjw02' Source='cartridges\japanese-100\content\01-writing-systems\02-hiragana-vowels-k.md' KeyPath='yes'/></Component>
                                    <Component Id='jw03' Guid='*'><File Id='fjw03' Source='cartridges\japanese-100\content\01-writing-systems\03-hiragana-s-t.md' KeyPath='yes'/></Component>
                                    <Component Id='jw04' Guid='*'><File Id='fjw04' Source='cartridges\japanese-100\content\01-writing-systems\04-hiragana-n-h.md' KeyPath='yes'/></Component>
                                    <Component Id='jw05' Guid='*'><File Id='fjw05' Source='cartridges\japanese-100\content\01-writing-systems\05-hiragana-m-y-r-w-n.md' KeyPath='yes'/></Component>
                                </Directory>
                                <Directory Id='JpBasics' Name='02-hiragana-basics'>
                                    <Component Id='jb06' Guid='*'><File Id='fjb06' Source='cartridges\japanese-100\content\02-hiragana-basics\06-greetings.md' KeyPath='yes'/></Component>
                                    <Component Id='jb07' Guid='*'><File Id='fjb07' Source='cartridges\japanese-100\content\02-hiragana-basics\07-basic-grammar.md' KeyPath='yes'/></Component>
                                    <Component Id='jb08' Guid='*'><File Id='fjb08' Source='cartridges\japanese-100\content\02-hiragana-basics\08-numbers.md' KeyPath='yes'/></Component>
                                </Directory>
                                <Directory Id='JpFirstWords' Name='03-first-words'>
                                    <Component Id='jf09' Guid='*'><File Id='fjf09' Source='cartridges\japanese-100\content\03-first-words\09-katakana-intro.md' KeyPath='yes'/></Component>
                                    <Component Id='jf10' Guid='*'><File Id='fjf10' Source='cartridges\japanese-100\content\03-first-words\10-essential-vocabulary.md' KeyPath='yes'/></Component>
                                </Directory>
                            </Directory>

                            <Directory Id='JpQuestions' Name='questions'>
                                <Component Id='jq01' Guid='*'><File Id='fjq01' Source='cartridges\japanese-100\questions\grammar.toml' KeyPath='yes'/></Component>
                                <Component Id='jq02' Guid='*'><File Id='fjq02' Source='cartridges\japanese-100\questions\vocabulary.toml' KeyPath='yes'/></Component>
                                <Component Id='jq03' Guid='*'><File Id='fjq03' Source='cartridges\japanese-100\questions\writing-systems.toml' KeyPath='yes'/></Component>
                            </Directory>
                        </Directory>

                        <!-- Gnostic Texts -->
                        <Directory Id='CartGnostic' Name='gnostic-texts'>
                            <Component Id='gn_manifest' Guid='*'>
                                <File Id='gn_manifest_f' Source='cartridges\gnostic-texts\manifest.toml' KeyPath='yes'/>
                            </Component>

                            <Directory Id='GnContent' Name='content'>
                                <Directory Id='GnIntro' Name='01-introduction'>
                                    <Component Id='gi01' Guid='*'><File Id='fgi01' Source='cartridges\gnostic-texts\content\01-introduction\01-what-is-gnosticism.md' KeyPath='yes'/></Component>
                                    <Component Id='gi02' Guid='*'><File Id='fgi02' Source='cartridges\gnostic-texts\content\01-introduction\02-primary-sources.md' KeyPath='yes'/></Component>
                                </Directory>
                                <Directory Id='GnNH' Name='02-nag-hammadi'>
                                    <Component Id='gn01' Guid='*'><File Id='fgn01' Source='cartridges\gnostic-texts\content\02-nag-hammadi\01-the-discovery.md' KeyPath='yes'/></Component>
                                    <Component Id='gn02' Guid='*'><File Id='fgn02' Source='cartridges\gnostic-texts\content\02-nag-hammadi\02-codices-and-tractates.md' KeyPath='yes'/></Component>
                                    <Component Id='gn03' Guid='*'><File Id='fgn03' Source='cartridges\gnostic-texts\content\02-nag-hammadi\03-key-tractates.md' KeyPath='yes'/></Component>
                                </Directory>
                                <Directory Id='GnPS' Name='03-pistis-sophia'>
                                    <Component Id='gp01' Guid='*'><File Id='fgp01' Source='cartridges\gnostic-texts\content\03-pistis-sophia\01-the-askew-codex.md' KeyPath='yes'/></Component>
                                    <Component Id='gp02' Guid='*'><File Id='fgp02' Source='cartridges\gnostic-texts\content\03-pistis-sophia\02-structure-and-books.md' KeyPath='yes'/></Component>
                                    <Component Id='gp03' Guid='*'><File Id='fgp03' Source='cartridges\gnostic-texts\content\03-pistis-sophia\03-mary-magdalene-interpreter.md' KeyPath='yes'/></Component>
                                    <Component Id='gp04' Guid='*'><File Id='fgp04' Source='cartridges\gnostic-texts\content\03-pistis-sophia\04-cosmology-of-the-spheres.md' KeyPath='yes'/></Component>
                                </Directory>
                                <Directory Id='GnOther' Name='04-other-texts'>
                                    <Component Id='go01' Guid='*'><File Id='fgo01' Source='cartridges\gnostic-texts\content\04-other-texts\01-books-of-jeu.md' KeyPath='yes'/></Component>
                                    <Component Id='go02' Guid='*'><File Id='fgo02' Source='cartridges\gnostic-texts\content\04-other-texts\02-berlin-codex.md' KeyPath='yes'/></Component>
                                    <Component Id='go03' Guid='*'><File Id='fgo03' Source='cartridges\gnostic-texts\content\04-other-texts\03-heresiologists.md' KeyPath='yes'/></Component>
                                </Directory>
                                <Directory Id='GnThemes' Name='05-themes'>
                                    <Component Id='gt01' Guid='*'><File Id='fgt01' Source='cartridges\gnostic-texts\content\05-themes\01-pleroma-and-aeons.md' KeyPath='yes'/></Component>
                                    <Component Id='gt02' Guid='*'><File Id='fgt02' Source='cartridges\gnostic-texts\content\05-themes\02-sophia-and-the-demiurge.md' KeyPath='yes'/></Component>
                                    <Component Id='gt03' Guid='*'><File Id='fgt03' Source='cartridges\gnostic-texts\content\05-themes\03-archons-and-heimarmene.md' KeyPath='yes'/></Component>
                                </Directory>
                            </Directory>

                            <Directory Id='GnQuestions' Name='questions'>
                                <Component Id='gq01' Guid='*'><File Id='fgq01' Source='cartridges\gnostic-texts\questions\introduction.toml' KeyPath='yes'/></Component>
                                <Component Id='gq02' Guid='*'><File Id='fgq02' Source='cartridges\gnostic-texts\questions\nag-hammadi.toml' KeyPath='yes'/></Component>
                                <Component Id='gq03' Guid='*'><File Id='fgq03' Source='cartridges\gnostic-texts\questions\pistis-sophia.toml' KeyPath='yes'/></Component>
                                <Component Id='gq04' Guid='*'><File Id='fgq04' Source='cartridges\gnostic-texts\questions\other-texts.toml' KeyPath='yes'/></Component>
                                <Component Id='gq05' Guid='*'><File Id='fgq05' Source='cartridges\gnostic-texts\questions\themes.toml' KeyPath='yes'/></Component>
                            </Directory>
                        </Directory>

                        <!-- Claude Architect Foundations -->
                        <Directory Id='CartClaude' Name='claude-architect-foundations'>
                            <Component Id='ca_manifest' Guid='*'>
                                <File Id='ca_manifest_f' Source='cartridges\claude-architect-foundations\manifest.toml' KeyPath='yes'/>
                            </Component>

                            <Directory Id='CaContent' Name='content'>
                                <Directory Id='CaIntro' Name='01-introduction'>
                                    <Component Id='ci01' Guid='*'><File Id='fci01' Source='cartridges\claude-architect-foundations\content\01-introduction\01-what-is-claude.md' KeyPath='yes'/></Component>
                                    <Component Id='ci02' Guid='*'><File Id='fci02' Source='cartridges\claude-architect-foundations\content\01-introduction\02-the-messages-api.md' KeyPath='yes'/></Component>
                                </Directory>
                                <Directory Id='CaPrompt' Name='02-prompting'>
                                    <Component Id='cp01' Guid='*'><File Id='fcp01' Source='cartridges\claude-architect-foundations\content\02-prompting\01-system-and-messages.md' KeyPath='yes'/></Component>
                                    <Component Id='cp02' Guid='*'><File Id='fcp02' Source='cartridges\claude-architect-foundations\content\02-prompting\02-prompt-engineering.md' KeyPath='yes'/></Component>
                                    <Component Id='cp03' Guid='*'><File Id='fcp03' Source='cartridges\claude-architect-foundations\content\02-prompting\03-prompt-caching.md' KeyPath='yes'/></Component>
                                </Directory>
                                <Directory Id='CaTools' Name='03-tool-use'>
                                    <Component Id='ct01' Guid='*'><File Id='fct01' Source='cartridges\claude-architect-foundations\content\03-tool-use\01-tool-use-basics.md' KeyPath='yes'/></Component>
                                    <Component Id='ct02' Guid='*'><File Id='fct02' Source='cartridges\claude-architect-foundations\content\03-tool-use\02-structured-outputs.md' KeyPath='yes'/></Component>
                                </Directory>
                                <Directory Id='CaAgents' Name='04-agents'>
                                    <Component Id='ca01' Guid='*'><File Id='fca01' Source='cartridges\claude-architect-foundations\content\04-agents\01-the-agent-loop.md' KeyPath='yes'/></Component>
                                    <Component Id='ca02' Guid='*'><File Id='fca02' Source='cartridges\claude-architect-foundations\content\04-agents\02-the-agent-sdk.md' KeyPath='yes'/></Component>
                                </Directory>
                                <Directory Id='CaMcp' Name='05-mcp'>
                                    <Component Id='cm01' Guid='*'><File Id='fcm01' Source='cartridges\claude-architect-foundations\content\05-mcp\01-what-is-mcp.md' KeyPath='yes'/></Component>
                                    <Component Id='cm02' Guid='*'><File Id='fcm02' Source='cartridges\claude-architect-foundations\content\05-mcp\02-mcp-servers-in-practice.md' KeyPath='yes'/></Component>
                                </Directory>
                                <Directory Id='CaSafety' Name='06-safety-and-deployment'>
                                    <Component Id='cs01' Guid='*'><File Id='fcs01' Source='cartridges\claude-architect-foundations\content\06-safety-and-deployment\01-constitutional-ai.md' KeyPath='yes'/></Component>
                                    <Component Id='cs02' Guid='*'><File Id='fcs02' Source='cartridges\claude-architect-foundations\content\06-safety-and-deployment\02-deployment-architecture.md' KeyPath='yes'/></Component>
                                </Directory>
                            </Directory>

                            <Directory Id='CaQuestions' Name='questions'>
                                <Component Id='cqa01' Guid='*'><File Id='fcqa01' Source='cartridges\claude-architect-foundations\questions\introduction.toml' KeyPath='yes'/></Component>
                                <Component Id='cqa02' Guid='*'><File Id='fcqa02' Source='cartridges\claude-architect-foundations\questions\prompting.toml' KeyPath='yes'/></Component>
                                <Component Id='cqa03' Guid='*'><File Id='fcqa03' Source='cartridges\claude-architect-foundations\questions\tool-use.toml' KeyPath='yes'/></Component>
                                <Component Id='cqa04' Guid='*'><File Id='fcqa04' Source='cartridges\claude-architect-foundations\questions\agents.toml' KeyPath='yes'/></Component>
                                <Component Id='cqa05' Guid='*'><File Id='fcqa05' Source='cartridges\claude-architect-foundations\questions\mcp.toml' KeyPath='yes'/></Component>
                                <Component Id='cqa06' Guid='*'><File Id='fcqa06' Source='cartridges\claude-architect-foundations\questions\safety-and-deployment.toml' KeyPath='yes'/></Component>
                            </Directory>
                        </Directory>

                    </Directory>

                    <Component Id='DesktopShortcut' Guid='C3D4E5F6-A7B8-9012-CDEF-345678901234'>
                        <Shortcut Id='DesktopShortcut'
                            Name='ExamHelper'
                            Description='Learning console with TTS narration and exam practice'
                            Directory='DesktopFolder'
                            Target='[Bin]examhelper.exe'
                            WorkingDirectory='APPLICATIONFOLDER'
                            Icon='ProductICO' />
                        <RegistryValue Root='HKCU'
                            Key='Software\ophiocus\ExamHelper'
                            Name='DesktopShortcut'
                            Type='integer'
                            Value='1'
                            KeyPath='yes' />
                    </Component>

                </Directory>
            </Directory>
            <Directory Id='DesktopFolder' Name='Desktop' />
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs ExamHelper with all cartridges.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='License'/>
            <ComponentRef Id='binary0'/>
            <ComponentRef Id='DesktopShortcut'/>

            <!-- Colombian cartridge -->
            <ComponentRef Id='col_manifest'/>
            <ComponentRef Id='cc01'/><ComponentRef Id='cc02'/><ComponentRef Id='cc03'/>
            <ComponentRef Id='cc04'/><ComponentRef Id='cc05'/><ComponentRef Id='cc06'/>
            <ComponentRef Id='cc07'/>
            <ComponentRef Id='ch01'/><ComponentRef Id='ch01b'/><ComponentRef Id='ch02'/>
            <ComponentRef Id='ch03'/><ComponentRef Id='ch04'/><ComponentRef Id='ch05'/>
            <ComponentRef Id='ch06'/><ComponentRef Id='ch07'/>
            <ComponentRef Id='cg01'/><ComponentRef Id='cg02'/><ComponentRef Id='cg03'/>
            <ComponentRef Id='cg04'/><ComponentRef Id='cg05'/>
            <ComponentRef Id='ccu01'/><ComponentRef Id='ccu02'/><ComponentRef Id='ccu03'/>
            <ComponentRef Id='ccu04'/><ComponentRef Id='ccu05'/><ComponentRef Id='ccu06'/>
            <ComponentRef Id='cq01'/><ComponentRef Id='cq02'/>
            <ComponentRef Id='cq03'/><ComponentRef Id='cq04'/>

            <!-- Gnostic cartridge -->
            <ComponentRef Id='gn_manifest'/>
            <ComponentRef Id='gi01'/><ComponentRef Id='gi02'/>
            <ComponentRef Id='gn01'/><ComponentRef Id='gn02'/><ComponentRef Id='gn03'/>
            <ComponentRef Id='gp01'/><ComponentRef Id='gp02'/><ComponentRef Id='gp03'/>
            <ComponentRef Id='gp04'/>
            <ComponentRef Id='go01'/><ComponentRef Id='go02'/><ComponentRef Id='go03'/>
            <ComponentRef Id='gt01'/><ComponentRef Id='gt02'/><ComponentRef Id='gt03'/>
            <ComponentRef Id='gq01'/><ComponentRef Id='gq02'/><ComponentRef Id='gq03'/>
            <ComponentRef Id='gq04'/><ComponentRef Id='gq05'/>

            <!-- Claude Architect Foundations cartridge -->
            <ComponentRef Id='ca_manifest'/>
            <ComponentRef Id='ci01'/><ComponentRef Id='ci02'/>
            <ComponentRef Id='cp01'/><ComponentRef Id='cp02'/><ComponentRef Id='cp03'/>
            <ComponentRef Id='ct01'/><ComponentRef Id='ct02'/>
            <ComponentRef Id='ca01'/><ComponentRef Id='ca02'/>
            <ComponentRef Id='cm01'/><ComponentRef Id='cm02'/>
            <ComponentRef Id='cs01'/><ComponentRef Id='cs02'/>
            <ComponentRef Id='cqa01'/><ComponentRef Id='cqa02'/><ComponentRef Id='cqa03'/>
            <ComponentRef Id='cqa04'/><ComponentRef Id='cqa05'/><ComponentRef Id='cqa06'/>

            <!-- Japanese cartridge -->
            <ComponentRef Id='jp_manifest'/>
            <ComponentRef Id='jp_font'/>
            <ComponentRef Id='jw01'/><ComponentRef Id='jw02'/><ComponentRef Id='jw03'/>
            <ComponentRef Id='jw04'/><ComponentRef Id='jw05'/>
            <ComponentRef Id='jb06'/><ComponentRef Id='jb07'/><ComponentRef Id='jb08'/>
            <ComponentRef Id='jf09'/><ComponentRef Id='jf10'/>
            <ComponentRef Id='jq01'/><ComponentRef Id='jq02'/><ComponentRef Id='jq03'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of the [ProductName] executable to the PATH system environment variable.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Icon Id='ProductICO' SourceFile='assets\icon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO' />
        <Property Id='ARPHELPLINK' Value='https://github.com/ophiocus/examhelper'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
        </UI>

        <WixVariable Id='WixUILicenseRtf' Value='wix\License.rtf'/>

    </Product>

</Wix>
